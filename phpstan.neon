includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Level 9 is the highest level
	level: max

	paths:
		- src/
		- asset-manager.php
		- wp-asset-manager.php

	bootstrapFiles:
		- phpstan-bootstrap.php

	# Suppress warnings for ignore patterns that don't match any error, as some
	# patterns are only relevant for specific PHP/WP version combinations.
	reportUnmatchedIgnoredErrors: false

	ignoreErrors:
		# TAssetData generic type constraints: after array_merge / array mutations, PHPStan
		# loses track of the exact TAssetData shape and widens to plain array.
		- '#Property .+::\$(assets|assets_by_handle|asset_handles) .* does not accept array#'
		- '#Parameter \#1 \$(asset|args|stylesheet|script) of method .+::(pre_add_asset|post_validate_asset|add_asset)\(\) expects TAssetData of array, array(<string, .+>)? given#'
		- '#Possibly invalid array key type mixed\.#'

		# WP core globals ($wp_scripts, $wp_styles) are typed as mixed from $GLOBALS.
		# These are well-known WP objects accessed via ->registered and ->in_footer.
		- '#Cannot access property \$(registered|in_footer|handle|src|deps|ver) on mixed\.#'
		- '#Cannot access offset (string|int|mixed|\(int\|string\)) on mixed\.#'
		- '#Parameter \#1 \$array of function array_keys expects array, mixed given\.#'
		- '#Parameter \#2 \$haystack of function in_array expects array, mixed given\.#'
		- '#Parameter \#(1|2) \$(version1|string) of function (version_compare|explode) expects string, mixed given\.#'
		- '#Argument of an invalid type mixed supplied for foreach, only iterables are supported\.#'

		# Methods that have typed params but receive mixed-typed WP global object props.
		- '#Parameter \#(1|2|3) .+ of function .+ expects .+, mixed given\.#'

		# The is_string() check on $this->core_assets_global is always true after set_defaults()
		# assigns a string, but we keep it as a runtime guard for safety.
		- '#Call to function is_string\(\) with string will always evaluate to true\.#'

		# No value type specified – arrays in legacy code intentionally use untyped arrays.
		- '#no value type specified in iterable type array#'

		# SVG sprite and other classes: arithmetic on mixed-typed attribute values.
		- '#Binary operation .* between .* results in an error\.#'
		- '#Cannot cast mixed to (string|int|float)#'

		# array_map with 'esc_attr' – PHPStan can't verify the string callback at max level.
		- '#Parameter \#1 \$callback of function array_map expects \(callable\(mixed\): mixed\)\|null, .esc_attr. given\.#'

		# asset_should_load: array_search may return int|false; the false === check is intentional.
		- '#Strict comparison using === between false and int#'

		# Mantle\Support\Traits\Singleton provides instance() method; the trait is a
		# dev dependency installed in CI but not always locally during analysis.
		- '#Class .+ uses unknown trait Mantle\\Support\\Traits\\Singleton\.#'
		- '#Call to an undefined static method .+::instance\(\)\.#'
		- '#Cannot call method .+ on mixed\.#'
		- '#Function .+ should return .+ but returns mixed\.#'
		- '#Cannot access property \$asset_handles on mixed\.#'

		# implode(): $default_classes is array<string> but PHPStan widens to array after
		# the [] push operation because TAssetData keys are unresolved.
		- '#Parameter \#2 \$array of function implode expects array<string>, array given\.#'

		# Offset might not exist: optional array keys in the TAssetData shapes.
		- "#Offset 'load_method' might not exist on#"
		- "#Offset '(handle|src|deps|version|in_footer|media|type)' might not exist on#"

		# printf/sprintf with mixed-typed inline content (e.g. file_get_contents result).
		- '#Parameter \#[0-9]+ \.\.\.\$values of function (printf|sprintf) expects .+, mixed given\.#'

		# Styles async print: media attribute may be mixed.
		- "#Binary operation \".\" between '.*' and mixed results in an error\.#"

		# WP_Dependencies::$done is a valid array property on both WP_Styles and WP_Scripts.
		# PHPStan sees WP_Dependencies as a union type that may not have $done.
		- '#Cannot access property \$done on WP_(Dependencies|Scripts|Styles)#'
		- '#Property WP_(Dependencies|Scripts|Styles)::\$done .* does not accept#'
